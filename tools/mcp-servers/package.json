{
  "name": "docfork-local",
  "version": "1.0.0",
  "description": "Local document indexer with MCP interface using Ollama",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "docfork-local": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "index": "node dist/indexer.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "zod": "^3.22.4",
    "chokidar": "^3.6.0",
    "node-cron": "^3.0.3",
    "glob": "^10.3.10",
    "minimatch": "^9.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
  },
  "overrides": {
    "node-cron": {
      "uuid": "11.1.1"
    }
  }
}
